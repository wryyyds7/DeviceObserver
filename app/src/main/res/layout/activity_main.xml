<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0F"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 摘要栏 -->
        <TextView
            android:id="@+id/tv_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="#12131A"
            android:padding="12dp"
            android:text="采样中..."
            android:textColor="#9CA3AF"
            android:textSize="14sp" />

        <!-- CPU 图表 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="CPU 使用率"
            android:textColor="#F3F4F6"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.wry.deviceobserver.view.RealTimeChartView
            android:id="@+id/chart_cpu"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginBottom="20dp"
            android:background="#12131A" />

        <!-- 内存图表 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="内存使用率"
            android:textColor="#F3F4F6"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.wry.deviceobserver.view.RealTimeChartView
            android:id="@+id/chart_memory"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginBottom="20dp"
            android:background="#12131A" />

        <!-- 温度图表 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="CPU 温度"
            android:textColor="#F3F4F6"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.wry.deviceobserver.view.RealTimeChartView
            android:id="@+id/chart_temp"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginBottom="20dp"
            android:background="#12131A" />

        <!-- 进程入口 -->
        <Button
            android:id="@+id/btn_processes"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="查看进程列表 →"
            android:onClick="onProcessClick"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
