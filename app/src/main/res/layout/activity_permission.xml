<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0F"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="DeviceObserver"
            android:textColor="#F3F4F6"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="需要以下权限以启用全部功能："
            android:textColor="#9CA3AF"
            android:textSize="14sp" />

        <!-- 通知权限 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔔 通知权限"
                    android:textColor="#F3F4F6"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_notification_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="检测中..."
                    android:textColor="#9CA3AF"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_grant_notification"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="授权"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 使用情况权限 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📊 使用情况访问"
                    android:textColor="#F3F4F6"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_usage_stats_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="检测中..."
                    android:textColor="#9CA3AF"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_grant_usage_stats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="去设置"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Root 权限 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔒 Root 权限"
                    android:textColor="#F3F4F6"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_root_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="检测中..."
                    android:textColor="#9CA3AF"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 权限等级 -->
        <TextView
            android:id="@+id/tv_permission_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="当前等级: 检测中..."
            android:textColor="#A78BFA"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- 可用功能列表 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="当前可用的功能："
            android:textColor="#9CA3AF"
            android:textSize="13sp" />

        <ListView
            android:id="@+id/lv_features"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:layout_weight="0" />

        <!-- 开始按钮 -->
        <Button
            android:id="@+id/btn_start"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="开始监控 →"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
